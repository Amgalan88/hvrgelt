# Supabase тохиргоо.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary — газруудын зураг upload хийхэд ашиглана.
# Cloudinary Dashboard → Settings → Upload → Upload presets (unsigned нэмэх)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Push мэдэгдэл (зөвхөн public түлхүүр — эндээ орно).
# Тохиргооны бүрэн заавар: PUSH_NOTIFICATIONS_SETUP.md
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
