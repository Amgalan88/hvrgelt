# Supabase тохиргоо.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary — газруудын зураг upload хийхэд ашиглана.
# Cloudinary Dashboard → Settings → Upload → Upload presets (unsigned нэмэх)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Push мэдэгдэл (зөвхөн public түлхүүр — эндээ орно).
# Тохиргооны бүрэн заавар: PUSH_NOTIFICATIONS_SETUP.md
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Онлайн төлбөр — тохиргоо хэрэггүй. Сервер (api/payments.ts, Vercel) дээр
# Byl эсвэл QPay-ийн түлхүүр байвал автоматаар онлайн төлбөр, үгүй бол дансаар.
# Нууц түлхүүрүүд энд биш, Vercel-ийн Environment Variables-д (VITE_ угтваргүй):
#   BYL_API_TOKEN, BYL_PROJECT_ID, BYL_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY
# Заавар: BYL_SETUP.md
# manual — онлайн төлбөрийг албаар унтраана; mock — туршилтын QPay
VITE_PAYMENT_PROVIDER=

# Google Maps — заавал биш. Тохируулаагүй бол OpenStreetMap (үнэгүй) ажиллана.
# Түлхүүр буруу эсвэл billing идэвхгүй бол апп автоматаар OpenStreetMap руу шилжинэ.
# Заавар: GOOGLE_MAPS_SETUP.md
VITE_GOOGLE_MAPS_API_KEY=

# Утас баталгаажуулалт (Verify.MN) — эдгээрийг .env-д биш, Vercel →
# Environment Variables дээр тавина (VITE_ угтваргүй, нууц).
# aicargo-той нэг VERIFY_MN_API_KEY (нэг данс). Дараа нь салгаж болно.
#   VERIFY_MN_API_KEY=        production болон preview
#   APP_URL=https://hvrgelt.mn   production (callback https байх ёстой)
#   VERIFY_MN_MOCK=1          зөвхөн preview. production дээр бүү тавь.
