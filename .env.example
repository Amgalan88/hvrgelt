# Supabase тохиргоо.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary — газруудын зураг upload хийхэд ашиглана.
# Cloudinary Dashboard → Settings → Upload → Upload presets (unsigned нэмэх)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Push мэдэгдэл (зөвхөн public түлхүүр — эндээ орно).
# Тохиргооны бүрэн заавар: PUSH_NOTIFICATIONS_SETUP.md
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Онлайн төлбөр — qpay | bonum. Хоосон бол гарын авлагын горим
# (дансаар шилжүүлж, оператор баталгаажуулна).
# Нууц түлхүүр НЬ ЭНД ОРОХГҮЙ — Edge Function-ий secret-д хадгална:
#   supabase secrets set PAYMENT_PROVIDER=qpay QPAY_USERNAME=... QPAY_PASSWORD=...
VITE_PAYMENT_PROVIDER=

# Хөгжүүлэгчийн бүртгэл — энэ дугаар/нууц үгээр нэвтэрвэл role сонгох
# дэлгэц нээгдэж, бүх role руу шалгахаар чөлөөтэй шилжинэ.
# `npm run dev` үед тохируулаагүй ч 99000000 / dev1961 гэж ажиллана.
# Байршуулсан хувилбарт VITE_DEV_PASSWORD байхгүй бол бүртгэл ХААЛТТАЙ —
# хөгжүүлэлт дуусмагц энэ хоёр мөрийг хасаад дахин build хийнэ.
VITE_DEV_PHONE=99000000
VITE_DEV_PASSWORD=
