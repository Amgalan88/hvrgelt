# Supabase тохиргоо.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary — газруудын зураг upload хийхэд ашиглана.
# Cloudinary Dashboard → Settings → Upload → Upload presets (unsigned нэмэх)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Push мэдэгдэл (зөвхөн public түлхүүр — эндээ орно).
# Тохиргооны бүрэн заавар: PUSH_NOTIFICATIONS_SETUP.md
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Онлайн төлбөр — byl | qpay | bonum. Хоосон бол гарын авлагын горим
# (дансаар шилжүүлж, оператор баталгаажуулна).
# Нууц түлхүүр НЬ ЭНД ОРОХГҮЙ — Edge Function-ий secret-д хадгална:
#   supabase secrets set PAYMENT_PROVIDER=byl BYL_API_TOKEN=... BYL_PROJECT_ID=... BYL_WEBHOOK_SECRET=...
#   Заавар: BYL_SETUP.md
VITE_PAYMENT_PROVIDER=

# Google Maps — заавал биш. Тохируулаагүй бол OpenStreetMap (үнэгүй) ажиллана.
# Түлхүүр буруу эсвэл billing идэвхгүй бол апп автоматаар OpenStreetMap руу шилжинэ.
# Заавар: GOOGLE_MAPS_SETUP.md
VITE_GOOGLE_MAPS_API_KEY=
